# --- Service URLs ---
# Backend runs on http://localhost:8000 (uvicorn default)
# Swagger UI: http://localhost:8000/docs
# This URL must match CONFIG_API_BASE_URL in smrtvlt-firmware/sdkconfig.defaults

# --- Docker Services (Safe Defaults) ---
# These point to the internal Docker containers. 
# No need to change these if running via Docker Compose.
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/smartvault
REDIS_URL=redis://redis:6379/0

# --- App Settings ---
APP_ENV=development
DEBUG=true

# --- Secrets (REQUIRED) ---
# You must set these yourself.
# Run: openssl rand -hex 32
SECRET_KEY=super-secret-key-that-you-should-change-me
API_KEY=

# Get your DSN from https://sentry.io
SENTRY_DSN=https://your-key@o123456.ingest.sentry.io/7654321
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
SENTRY_SEND_DEFAULT_PII=false

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_API_TOKEN=your-generated-token-here

CORS_ORIGINS=["http://localhost:3001"]

# Email
EMAIL_BACKEND=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=your-gmail@gmail.com
SMTP_FROM_NAME=SmartVault
